CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE is not set
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/beetmeister.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BEET_ENABLE_BENCH_DIAGNOSTICS=y
CONFIG_BEET_BENCH_DIAGNOSTIC_PERIOD_S=10
CONFIG_BEET_BOOT_LOW_VOLTAGE_GRACE_MS=5000
CONFIG_BEET_BATTERY_SAMPLE_OVERLAY_COUNT=4
CONFIG_BEET_BATTERY_DIVIDER_SCALE_PERMILLE=2005
CONFIG_BEET_BATTERY_ADC_CALIBRATION_PERMILLE=1030
CONFIG_BEET_MOISTURE_SENSOR_SUPPLY_KNEE_MV=3332
CONFIG_BEET_SENSOR_POWER_GPIO=15
CONFIG_BEET_SENSOR_POWER_SETTLE_MS=50
CONFIG_BEET_BOOST_ENABLE_GPIO=16
CONFIG_BEET_ENABLE_OLED_DISPLAY=y
CONFIG_BEET_OLED_SDA_GPIO=11
CONFIG_BEET_OLED_SCL_GPIO=12
CONFIG_BEET_OLED_I2C_ADDRESS=0x3C
